{
  "name": "drawtell",
  "version": "0.1.0",
  "description": "draw & tell — turn problems into stroke-by-stroke chalkboard explanations, from your terminal.",
  "type": "module",
  "bin": {
    "drawtell": "bin/drawtell.js"
  },
  "files": [
    "bin"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm run sync-fonts && vite",
    "build": "pnpm run sync-fonts && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.cli.json",
    "sync-fonts": "rm -rf public/fonts && mkdir -p public && cp -R node_modules/@excalidraw/excalidraw/dist/prod/fonts public/fonts",
    "prepublishOnly": "echo '发布前先把 CLI 打包成 JS:src/cli 是 TS,装进 node_modules 后 Node 不做 type stripping,bin 会挂' && exit 1"
  },
  "keywords": [
    "chalkboard",
    "animation",
    "education",
    "excalidraw",
    "cli",
    "agent-friendly"
  ],
  "author": "tarslab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tarslab/drawtell.git"
  },
  "homepage": "https://github.com/tarslab/drawtell#readme",
  "bugs": {
    "url": "https://github.com/tarslab/drawtell/issues"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "excalidraw-animate": "0.7.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
